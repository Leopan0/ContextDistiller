{
  "name": "context-distiller",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: run context compaction with a dedicated model separate from the conversation model.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leopan0/context-distiller.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "llm",
    "compaction",
    "context-compression",
    "auxiliary-model"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('lib', { recursive: true, force: true });\"",
    "build:js": "node scripts/build.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:types": "tsc -p tsconfig.json",
    "build": "npm run clean && npm run build:js && npm run build:client && npm run build:types",
    "bundle": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gates": "node scripts/gates/run.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@dsh-plugin/dsh-loader": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "@dsh-plugin/dsh-loader": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-compaction-basic": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.8",
    "@dsh-plugin/dsh-loader": "^1.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  }
}
